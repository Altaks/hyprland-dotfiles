#!/usr/bin/env python3
"""Veille cybersécurité pour le tableau de bord Quickshell (onglet Cyber).

Output: one JSON document on stdout
  {"news": [...], "certfr": [...], "cves": [...], "kev": [...], "stats": {...}, "ts"}
- news   : The Hacker News, Zataz, CERT-FR actualités — {"title", "link", "source", "ts"}
- certfr : alertes + avis du CERT-FR — {"title", "link", "kind": "alerte"|"avis", "ts"}
- cves   : CVE publiées ces 3 derniers jours (NVD) avec CVSS ≥ 7 —
           {"id", "score", "severity", "version", "product", "desc", "ts", "kev", "watch", "epss", "link"}
- kev    : derniers ajouts au catalogue CISA KEV (vulnérabilités exploitées) — même forme
« watch » = la CVE touche un logiciel présent ici (liste WATCH ci-dessous).
Cached 1 h in ~/.cache/dashboard-cyber.json (NVD est lent, ~10 s) ; une source en échec garde le cache.
"""
import json, re, sys, time, urllib.request
from concurrent.futures import ThreadPoolExecutor
from datetime import datetime, timedelta, timezone
from email.utils import parsedate_to_datetime
import xml.etree.ElementTree as ET
from pathlib import Path

CACHE = Path.home() / ".cache/dashboard-cyber.json"
TTL = 3600
DAYS = 3
FEEDS = [("The Hacker News", "https://feeds.feedburner.com/TheHackersNews"),
         ("Zataz", "https://www.zataz.com/feed/"),
         ("CERT-FR", "https://www.cert.ssi.gouv.fr/actualite/feed/")]
CERTFR = [("alerte", "https://www.cert.ssi.gouv.fr/alerte/feed/"),
          ("avis", "https://www.cert.ssi.gouv.fr/avis/feed/")]
NVD = "https://services.nvd.nist.gov/rest/json/cves/2.0?pubStartDate={}&pubEndDate={}&resultsPerPage=2000"
KEV = "https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json"
EPSS = "https://api.first.org/data/v1/epss?cve={}"
# Logiciels de cette machine : une CVE dont le produit en nomme un est marquée « te concerne »
WATCH = re.compile(r"\b(" + "|".join([
    "linux", "nvidia", "firefox", "mozilla", "zen browser", "discord", "electron", "chromium", "openssh", "sudo",
    "glibc", "systemd", "pipewire", "hyprland", "wayland", "mesa", "gnome", "gtk", "qt", "cpython", "openssl",
    "gnutls", "curl", "git", "github cli", "node\\.js", "openjdk", "intellij", "jetbrains", "docker", "ubuntu",
    "polkit", "xz", "spotify", "minecraft", "steam", "ffmpeg", "mpv", "7-zip", "vim", "bash"]) + r")\b", re.I)


def get(url, timeout=20):
    req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0 (dashboard cyber)"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return r.read()


def iso_ts(s):
    s = s.replace("Z", "+00:00")
    dt = datetime.fromisoformat(s)
    return int((dt if dt.tzinfo else dt.replace(tzinfo=timezone.utc)).timestamp())


def rss(url, count=12):
    items = []
    for it in ET.fromstring(get(url)).iter("item"):
        try:
            ts = int(parsedate_to_datetime(it.findtext("pubDate")).timestamp())
        except (TypeError, ValueError):
            ts = 0
        items.append({"title": (it.findtext("title") or "").strip(), "link": (it.findtext("link") or "").strip(), "ts": ts})
    return items[:count]


def news():
    out = []
    for name, url in FEEDS:
        try:
            out += [{**i, "source": name} for i in rss(url, 10)]
        except Exception:
            pass
    if not out:
        raise RuntimeError("aucun flux")
    return sorted(out, key=lambda i: -i["ts"])[:20]


def certfr():
    out = []
    for kind, url in CERTFR:
        out += [{**i, "kind": kind} for i in rss(url, 10)]
    return sorted(out, key=lambda i: -i["ts"])


def watched(product):
    return bool(WATCH.search(product))


def product_of(cve):
    for a in cve.get("affected", []):  # format CVE 5 (fourni par le CNA, présent dès la publication)
        for d in a.get("affectedData", []):
            if d.get("product") and d.get("product") != "n/a":
                vendor = d.get("vendor", "")
                return (d["product"] if vendor in ("", "n/a") or vendor.lower() in d["product"].lower()
                        else f"{vendor} {d['product']}")
    for conf in cve.get("configurations", []):
        for node in conf.get("nodes", []):
            for m in node.get("cpeMatch", []):
                f = m.get("criteria", "").split(":")
                if len(f) > 4:
                    return f"{f[3]} {f[4]}".replace("_", " ")
    return ""


def score_of(metrics):
    """Meilleur score disponible : CVSS 4.0, puis 3.1, puis 3.0 (source primaire d'abord)."""
    for key, ver in (("cvssMetricV40", "4.0"), ("cvssMetricV31", "3.1"), ("cvssMetricV30", "3.0")):
        ms = metrics.get(key) or []
        if ms:
            m = sorted(ms, key=lambda m: m.get("type") != "Primary")[0]["cvssData"]
            return m.get("baseScore", 0), m.get("baseSeverity", ""), ver
    return 0, "", ""


def nvd():
    end = datetime.now(timezone.utc)
    fmt = lambda d: d.strftime("%Y-%m-%dT%H:%M:%S.000Z")
    data = json.loads(get(NVD.format(fmt(end - timedelta(days=DAYS)), fmt(end)), timeout=60))
    out = []
    for v in data.get("vulnerabilities", []):
        c = v["cve"]
        if c.get("vulnStatus") == "Rejected":
            continue
        score, sev, ver = score_of(c.get("metrics", {}))
        desc = next((d["value"] for d in c.get("descriptions", []) if d["lang"] == "en"), "")
        product = product_of(c)
        out.append({"id": c["id"], "score": score, "severity": sev, "version": ver, "product": product,
                    "desc": " ".join(desc.split()), "ts": iso_ts(c["published"]),
                    "watch": watched(product), "link": "https://nvd.nist.gov/vuln/detail/" + c["id"]})
    return out


def kev():
    return json.loads(get(KEV, timeout=30))["vulnerabilities"]


def epss(ids):
    out = {}
    for i in range(0, len(ids), 50):
        data = json.loads(get(EPSS.format(",".join(ids[i:i + 50]))))
        out.update({d["cve"]: float(d["epss"]) for d in data.get("data", [])})
    return out


def main():
    force = "--force" in sys.argv
    try:
        cached = json.loads(CACHE.read_text())
    except (OSError, ValueError):
        cached = {}
    if cached and not force and time.time() - cached.get("ts", 0) < TTL:
        print(json.dumps(cached))
        return

    with ThreadPoolExecutor(4) as pool:
        futs = {k: pool.submit(f) for k, f in (("news", news), ("certfr", certfr), ("nvd", nvd), ("kev", kev))}
    res, errors = {}, []
    for k, f in futs.items():
        try:
            res[k] = f.result()
        except Exception as e:
            res[k] = None
            errors.append(f"{k} : {e}")

    now = time.time()
    kev_all = res["kev"] or []
    kev_ids = {k["cveID"] for k in kev_all}
    if res["nvd"] is not None:
        all_cves = res["nvd"]
        for c in all_cves:
            c["kev"] = c["id"] in kev_ids
        cves = sorted((c for c in all_cves if c["score"] >= 7 or c["kev"]),
                      key=lambda c: (not c["watch"], -c["score"], not c["kev"], -c["ts"]))[:60]
        stats_cve = {"critical": sum(c["score"] >= 9 for c in all_cves),
                     "high": sum(7 <= c["score"] < 9 for c in all_cves), "total": len(all_cves)}
    else:
        cves, stats_cve = cached.get("cves", []), {k: cached.get("stats", {}).get(k, 0) for k in ("critical", "high", "total")}

    if res["kev"] is not None:
        nvd_by_id = {c["id"]: c for c in (res["nvd"] or [])}
        recent = sorted(kev_all, key=lambda k: k["dateAdded"], reverse=True)[:25]
        kev_list = [{"id": k["cveID"], "score": nvd_by_id.get(k["cveID"], {}).get("score", 0),
                     "severity": nvd_by_id.get(k["cveID"], {}).get("severity", ""), "version": "",
                     "product": f"{k['vendorProject']} {k['product']}", "desc": k["vulnerabilityName"],
                     "ts": iso_ts(k["dateAdded"] + "T12:00:00"), "kev": True,
                     "ransomware": k.get("knownRansomwareCampaignUse") == "Known",
                     "due": k.get("dueDate", ""),
                     "watch": watched(f"{k['vendorProject']} {k['product']}"),
                     "link": "https://nvd.nist.gov/vuln/detail/" + k["cveID"]} for k in recent]
        kev_list.sort(key=lambda c: (not c["watch"], -c["ts"], -c["score"]))
        kev_week = sum(iso_ts(k["dateAdded"] + "T12:00:00") > now - 7 * 86400 for k in kev_all)
    else:
        kev_list, kev_week = cached.get("kev", []), cached.get("stats", {}).get("kevWeek", 0)

    try:
        scores = epss(sorted({c["id"] for c in cves + kev_list}))
        for c in cves + kev_list:
            c["epss"] = scores.get(c["id"])
    except Exception as e:
        errors.append(f"epss : {e}")

    cert = res["certfr"] if res["certfr"] is not None else cached.get("certfr", [])
    out = {
        "news": res["news"] if res["news"] is not None else cached.get("news", []),
        "certfr": cert, "cves": cves, "kev": kev_list,
        "stats": {**stats_cve, "kevWeek": kev_week,
                  "alerts": sum(a["kind"] == "alerte" and a["ts"] > now - 30 * 86400 for a in cert)},
        "errors": errors, "ts": int(now),
    }
    CACHE.write_text(json.dumps(out))
    print(json.dumps(out))


if __name__ == "__main__":
    main()
