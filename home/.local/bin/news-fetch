#!/usr/bin/env python3
"""Actualités pour le tableau de bord Quickshell : locales (Nantes) et nationales, par flux RSS.

Parité politique du fil national : trois groupes symétriques de deux titres (classements usuels de la
presse française), 10 articles par groupe, en alternant les titres d'un même groupe — sinon le flux
le plus prolifique écrase les autres.
  gauche : Libération (gauche), Le Monde (centre-gauche)
  centre : franceinfo (service public), La Croix (centre)
  droite : Le Figaro (droite), L'Opinion (centre-droit)
Fil local : France 3 Nantes + 20 Minutes Nantes (info locale, non partisane), les plus récents.

Output: one JSON document on stdout {"local": [...], "national": [...], "fetched"}, chaque article
{"title", "link", "source", "lean", "bucket", "ts", "desc", "image", "thumb"}. Cached 15 min in
~/.cache/dashboard-news.json ; si un flux ne répond pas, on garde ses articles du cache.
Images : JPEG 720 px dans ~/.cache/dashboard-news/ (Qt n'a pas de plugin WebP ici, et France 3 ne sert
que du WebP derrière des URL signées). Libération ne met pas d'image dans son flux (et son site bloque
les robots) : ses articles s'affichent en tuiles texte.
"""
import hashlib, html, io, json, re, sys, time, urllib.request
from concurrent.futures import ThreadPoolExecutor
import xml.etree.ElementTree as ET
from email.utils import parsedate_to_datetime
from pathlib import Path
from PIL import Image

CACHE = Path.home() / ".cache/dashboard-news.json"
THUMBS = Path.home() / ".cache/dashboard-news"
TTL = 900
LOCAL_COUNT = 30
PER_BUCKET = 10
# (source, url, orientation affichée, groupe)
FEEDS = {
    "local": [("France 3 Nantes", "https://france3-regions.francetvinfo.fr/pays-de-la-loire/loire-atlantique/nantes/rss", "", ""),
              ("20 Minutes Nantes", "https://www.20minutes.fr/feeds/rss-nantes.xml", "", "")],
    "national": [("Libération", "https://www.liberation.fr/arc/outboundfeeds/rss-all/?outputType=xml", "gauche", "gauche"),
                 ("Le Monde", "https://www.lemonde.fr/rss/une.xml", "centre-gauche", "gauche"),
                 ("franceinfo", "https://www.francetvinfo.fr/titres.rss", "service public", "centre"),
                 ("La Croix", "https://www.la-croix.com/RSS/UNIVERS", "centre", "centre"),
                 ("Le Figaro", "https://www.lefigaro.fr/rss/figaro_actualites.xml", "droite", "droite"),
                 ("L'Opinion", "https://www.lopinion.fr/index.rss", "centre-droit", "droite")],
}
BUCKETS = ["gauche", "centre", "droite"]
MAX_AGE = 2 * 86400  # L'Opinion garde 10 jours d'articles dans son flux


def get(url, timeout=10):
    req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0 (dashboard news)"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return r.read()


def image_url(item):
    """<enclosure url> (franceinfo, France 3…) ou <media:content|thumbnail url> (Le Monde…)."""
    for child in item:
        tag = child.tag.split("}")[-1]
        if tag in ("enclosure", "content", "thumbnail") and child.get("url") \
                and child.get("type", "image").startswith("image"):
            return child.get("url")
    return ""


def thumbnail(a):
    """Chemin local de l'image JPEG (téléchargée une seule fois), "" en cas d'échec."""
    url = a["image"]
    if not url:
        return ""
    path = THUMBS / (hashlib.sha1(url.encode()).hexdigest()[:16] + "-720.jpg")
    if not path.exists():
        try:
            im = Image.open(io.BytesIO(get(url))).convert("RGB")
            im.thumbnail((720, 720))
            im.save(path, "JPEG", quality=85)
        except Exception:
            return ""
    return str(path)


def fetch(source, url, lean, bucket):
    root = ET.fromstring(get(url))
    items = []
    for it in root.iter("item"):
        title, link = (it.findtext("title") or "").strip(), (it.findtext("link") or "").strip()
        if not title or not link:
            continue
        try:
            ts = parsedate_to_datetime(it.findtext("pubDate")).timestamp()
        except Exception:
            ts = 0
        desc = " ".join(html.unescape(re.sub(r"<[^>]+>", " ", it.findtext("description") or "")).split())
        items.append({"title": html.unescape(title), "link": link, "source": source, "lean": lean, "bucket": bucket,
                      "ts": ts, "desc": desc[:320], "image": image_url(it)})
    return items


def dedup(items):
    seen, out = set(), []
    for a in sorted(items, key=lambda a: -a["ts"]):
        key = re.sub(r"\W+", " ", a["title"].lower()).strip()
        if key not in seen:
            seen.add(key)
            out.append(a)
    return out


def balanced(items):
    """PER_BUCKET articles par groupe, en alternant les titres du groupe (plus récents d'abord)."""
    out = []
    for b in BUCKETS:
        queues = [[a for a in items if a["source"] == s] for s, _, _, bb in FEEDS["national"] if bb == b]
        picked = []
        while len(picked) < PER_BUCKET and any(queues):
            for q in queues:
                if q and len(picked) < PER_BUCKET:
                    picked.append(q.pop(0))
        out += picked
    return sorted(out, key=lambda a: -a["ts"])


try:
    cache = json.loads(CACHE.read_text())
except Exception:
    cache = {}
if time.time() - cache.get("fetched", 0) < TTL and "--force" not in sys.argv:
    print(json.dumps(cache))
    sys.exit()

out = {"fetched": time.time()}
with ThreadPoolExecutor(8) as pool:
    jobs = {(kind, f[0]): pool.submit(fetch, *f) for kind, feeds in FEEDS.items() for f in feeds}
for kind, feeds in FEEDS.items():
    items = []
    for f in feeds:
        try:
            items += jobs[(kind, f[0])].result()
        except Exception:
            items += [a for a in cache.get(kind, []) if a["source"] == f[0]]
    items = dedup(items)
    if kind == "national":
        items = [a for a in items if time.time() - a["ts"] < MAX_AGE]
    out[kind] = balanced(items) if kind == "national" else items[:LOCAL_COUNT]

THUMBS.mkdir(parents=True, exist_ok=True)
articles = out["local"] + out["national"]
with ThreadPoolExecutor(8) as pool:
    for a, path in zip(articles, pool.map(thumbnail, articles)):
        a["thumb"] = path
# Images plus vieilles que 3 jours : on fait le ménage
keep = {a["thumb"] for a in articles}
for f in THUMBS.glob("*.jpg"):
    if str(f) not in keep and time.time() - f.stat().st_mtime > 3 * 86400:
        f.unlink(missing_ok=True)

CACHE.write_text(json.dumps(out))
print(json.dumps(out))
