#!/usr/bin/env python3
"""Arrange every window of the current workspace in an even grid (Super+G).

Windows are made floating and placed in equal cells inside the usable area
(monitor minus Waybar), with the same gaps as the tiling layout.
`hypr-grid off` (Super+Shift+G) puts them back into normal tiling.
A workspace id can be given to act on it instead: `hypr-grid 7`, `hypr-grid off 7`.
"""
import json, math, subprocess, sys

GAP_OUT, GAP_IN = 10, 10

def hyprctl(*args):
    return subprocess.run(["hyprctl", *args], capture_output=True, text=True).stdout

def dispatch(*cmds):
    # Batch: one IPC round-trip, no visible intermediate state.
    hyprctl("--batch", " ; ".join("dispatch " + c for c in cmds))

args = sys.argv[1:]
off = "off" in args
ws_ids = [int(a) for a in args if a.isdigit()]
if ws_ids:
    ws = next(w for w in json.loads(hyprctl("-j", "workspaces")) if w["id"] == ws_ids[0])
else:
    ws = json.loads(hyprctl("-j", "activeworkspace"))
mon = next(m for m in json.loads(hyprctl("-j", "monitors")) if m["name"] == ws["monitor"])
wins = sorted((c for c in json.loads(hyprctl("-j", "clients"))
               if c["workspace"]["id"] == ws["id"] and c["mapped"] and not c["hidden"]),
              key=lambda c: (c["at"][1], c["at"][0]))
if not wins:
    sys.exit()

if off:
    dispatch(*(f"settiled address:{c['address']}" for c in wins))
    sys.exit()

n = len(wins)
cols = math.ceil(math.sqrt(n))
rows = math.ceil(n / cols)
left, top, right, bottom = mon["reserved"]
scale = mon["scale"]
area_x = mon["x"] + left + GAP_OUT
area_y = mon["y"] + top + GAP_OUT
area_w = mon["width"] / scale - left - right - 2 * GAP_OUT
area_h = mon["height"] / scale - top - bottom - 2 * GAP_OUT
cell_w = (area_w - (cols - 1) * GAP_IN) / cols
cell_h = (area_h - (rows - 1) * GAP_IN) / rows

cmds = []
for i, c in enumerate(wins):
    r, col = divmod(i, cols)
    # Last row is centred when it is not full
    in_row = min(cols, n - r * cols)
    offset = (cols - in_row) * (cell_w + GAP_IN) / 2
    x = round(area_x + offset + col * (cell_w + GAP_IN))
    y = round(area_y + r * (cell_h + GAP_IN))
    a = c["address"]
    if not c["floating"]:
        cmds.append(f"setfloating address:{a}")
    cmds.append(f"resizewindowpixel exact {round(cell_w)} {round(cell_h)},address:{a}")
    cmds.append(f"movewindowpixel exact {x} {y},address:{a}")
dispatch(*cmds)
